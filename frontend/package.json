{
  "name": "cloudresume",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "build": "yarn typecheck && vite build",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node --import tsx scripts/validate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.11",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  }
}
